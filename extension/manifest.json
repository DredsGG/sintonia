{
  "manifest_version": 3,
  "name": "Sintonia",
  "version": "1.1.0",
  "default_locale": "en",
  "description": "__MSG_appDesc__",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/sw.js"
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "alarms",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://sponsor.ajay.app/*",
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "src/defaults.js",
        "src/i18n.js",
        "src/novidades.js",
        "src/comum.js",
        "src/vendor/qrcode.js",
        "src/apoio.js",
        "src/datas.js",
        "src/core.js",
        "src/ui.js",
        "src/emdia.js",
        "src/fila.js",
        "src/atalhos.js",
        "src/player.js",
        "src/player2.js",
        "src/like.js",
        "src/distracoes.js",
        "src/audio.js",
        "src/sb.js",
        "src/imagem.js",
        "src/comentarios.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "author": "Dreds",
  "homepage_url": "https://github.com/DredsGG/sintonia",
  "minimum_chrome_version": "111"
}
